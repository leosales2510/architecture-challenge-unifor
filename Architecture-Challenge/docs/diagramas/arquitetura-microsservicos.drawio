ck;html=1;dashed=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="315" y="620"/><mxPoint x="1140" y="620"/><mxPoint x="1140" y="460"/></Array></mxGeometry></mxCell><mxCell id="c23" value="POST /montagens&lt;br&gt;(preço oficial)" style="endArrow=block;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="disponibilidade · reservas&lt;br&gt;confirmação · liberação" style="endArrow=block;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="POST /api/pagamentos" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="690"/></Array></mxGeometry></mxCell><mxCell id="c26" value="Adapter" style="endArrow=block;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Decisões&lt;/b&gt;: REST síncrono com contratos JSON explícitos (DTOs por serviço, sem biblioteca compartilhada); um banco H2 por serviço (nenhum serviço lê a tabela de outro); pedido-service orquestra o checkout como saga (reserva → cobrança → confirmação; liberação da reserva como compensação só quando o pagamento comprovadamente não ocorreu); erros RFC 7807 com campo &quot;codigo&quot;. Cada serviço: Controller → Service/Facade → Domínio → Repository (Service Layer)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="640" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>